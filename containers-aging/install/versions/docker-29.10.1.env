# Docker Engine 29.10.1 (ultimo release em 2026-11), com os mesmos componentes do release
# oficial (moby/moby@docker-v29.10.1: Dockerfile -> GO_VERSION, CONTAINERD_VERSION, RUNC_VERSION,
# TINI_VERSION). A partir da v29 as tags do moby tem o prefixo "docker-" e o moby e' um modulo
# Go (go.mod); o cli continua com vendor.mod.
# Cada fonte e' baixada pela tag e conferida pelo commit: mudar qualquer valor aqui muda o
# software medido, entao trate este arquivo como parte do desenho do experimento.
DOCKER_VERSION=29.10.1
GO_VERSION=1.27.4

MOBY_REPO=https://github.com/moby/moby
MOBY_REF=docker-v29.10.1
MOBY_COMMIT=54cd494d0b39abfc7a958fcc876f706271f8b909

CLI_REPO=https://github.com/docker/cli
CLI_REF=v29.10.1
CLI_COMMIT=c48360f51c53d2029ab6721ad4d012f9e14df846

CONTAINERD_REPO=https://github.com/containerd/containerd
CONTAINERD_REF=v2.4.2
CONTAINERD_COMMIT=b7a25261e029d68978bbf290df0a62fc819b3c51

RUNC_REPO=https://github.com/opencontainers/runc
RUNC_REF=v1.5.3
RUNC_COMMIT=46365c62967c76a765a5e347f48f0c7b3b571fe9
# Igual ao release oficial (Dockerfile do moby): sem a libpathrs (biblioteca Rust), padrao no runc >= 1.5.
RUNC_BUILDTAGS="-libpathrs"

TINI_REPO=https://github.com/krallin/tini
TINI_REF=v0.19.0
TINI_COMMIT=de40ad007797e0dcd8b7126f27bb87401d224240

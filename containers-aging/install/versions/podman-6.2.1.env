# Podman 6.2.1 (ultimo release, 2026-11-24) e as ultimas versoes publicadas dos componentes
# ate essa data. Go igual ao do Docker 29.10.1, para os dois runtimes serem compilados pelo
# mesmo compilador. Rust: stable mais recente (netavark/aardvark-dns 2.1 exigem >= 1.88).
PODMAN_VERSION=6.2.1
GO_VERSION=1.27.4
RUST_VERSION=1.100.1

PODMAN_REPO=https://github.com/containers/podman
PODMAN_REF=v6.2.1
PODMAN_COMMIT=3471162efb28760529d852706c493c29245def6d
# Mesmos recursos em todas as distros (sem a deteccao automatica do Makefile). Sem libsqlite3:
# usa o sqlite embutido no binario, identico em todos os sistemas.
PODMAN_BUILDTAGS="grpcnotrace apparmor selinux seccomp systemd exclude_graphdriver_btrfs"

CRUN_VERSION=1.31
CRUN_URL=https://github.com/containers/crun/releases/download/1.31/crun-1.31.tar.gz
CRUN_SHA256=17d04ba159fada1f1300a36b8afe869afb38bf1bbda28da052e83bb4bee20108

CONMON_REPO=https://github.com/containers/conmon
CONMON_REF=v2.2.1
CONMON_COMMIT=c8cc2c4db27531bd4e084ce7857f73cd21ee639d

# netavark 2.x removeu o suporte a iptables: o firewall e' sempre nftables (precisa do `nft`).
NETAVARK_REPO=https://github.com/containers/netavark
NETAVARK_REF=v2.1.0
NETAVARK_COMMIT=8e91ad1d947ed325327b638f0cb906bea1f7d0ab
NETAVARK_FIREWALL_DRIVER=nftables

AARDVARK_REPO=https://github.com/containers/aardvark-dns
AARDVARK_REF=v2.1.0
AARDVARK_COMMIT=cd7417681229219059939bdd9f0b3bd9ac9abb08

CATATONIT_REPO=https://github.com/openSUSE/catatonit
CATATONIT_REF=v0.2.1
CATATONIT_COMMIT=bb3b96b99668e544618c5aec427c1f4b6b9ee9bb
